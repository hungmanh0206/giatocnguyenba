rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function familyDocument(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function membership(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/memberships/$(request.auth.uid));
    }

    function hasMembership(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/memberships/$(request.auth.uid));
    }

    function isSuperAdmin(familyId) {
      return hasMembership(familyId)
        && exists(/databases/$(database)/documents/families/$(familyId))
        && familyDocument(familyId).data.superAdminUid == request.auth.uid
        && membership(familyId).data.role == 'super_admin';
    }

    function canEdit(familyId) {
      return isSuperAdmin(familyId);
    }

    function validAnniversary(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['day', 'month'])
        && value.day is int && value.day >= 1 && value.day <= 30
        && value.month is int && value.month >= 1 && value.month <= 12);
    }

    function validDeathDate(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['day', 'month', 'year'])
        && value.keys().hasAll(['day', 'month'])
        && value.day is int && value.day >= 1 && value.day <= 30
        && value.month is int && value.month >= 1 && value.month <= 12
        && (!value.keys().hasAll(['year'])
          || (value.year is int && value.year >= 1600 && value.year <= 3000)));
    }

    function validMember(memberId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'name', 'displayName', 'nameKnown', 'tabooName', 'styleName', 'gender', 'isClanMember', 'lineageType', 'generation', 'branch', 'branchOrigin', 'sourceContextParentId', 'siblingOrder', 'born', 'died', 'diedText', 'deathDate', 'lifeStatus', 'parents', 'spouses', 'anniversary', 'biography', 'hometown', 'needsVerification', 'sourceReference', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'name', 'displayName', 'nameKnown', 'tabooName', 'styleName', 'gender', 'isClanMember', 'lineageType', 'generation', 'branch', 'branchOrigin', 'sourceContextParentId', 'siblingOrder', 'born', 'died', 'diedText', 'deathDate', 'lifeStatus', 'parents', 'spouses', 'anniversary', 'biography', 'hometown', 'needsVerification', 'sourceReference', 'createdAt', 'updatedAt'])
        && data.id == memberId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && data.nameKnown is bool
        && (data.tabooName == null || (data.tabooName is string && data.tabooName.size() <= 100))
        && (data.styleName == null || (data.styleName is string && data.styleName.size() <= 100))
        && data.gender in ['male', 'female', 'unknown']
        && data.isClanMember is bool
        && data.lineageType in ['direct', 'maternal-terminal']
        && data.generation is int && data.generation >= 1 && data.generation <= 50
        && data.branch is int && data.branch >= -1 && data.branch <= 20
        && data.branchOrigin is bool
        && (data.sourceContextParentId == null || (data.sourceContextParentId is string && data.sourceContextParentId.size() <= 150))
        && (data.siblingOrder == null || (data.siblingOrder is int && data.siblingOrder >= 1 && data.siblingOrder <= 999))
        && (data.born == null || (data.born is int && data.born >= 1600 && data.born <= 3000))
        && (data.died == null || (data.died is int && data.died >= 1600 && data.died <= 3000 && (data.born == null || data.died >= data.born)))
        && (data.diedText == null || (data.diedText is string && data.diedText.size() <= 100))
        && validDeathDate(data.deathDate)
        && (data.deathDate == null || data.died == null
          || !data.deathDate.keys().hasAll(['year'])
          || data.deathDate.year == data.died)
        && (data.lifeStatus == null || data.lifeStatus in ['living', 'deceased', 'unknown'])
        && (data.lifeStatus == null || data.lifeStatus == 'deceased' || (data.died == null && data.diedText == null && data.deathDate == null && data.anniversary == null))
        && data.parents is list && data.parents.size() <= 2
        && data.spouses is list && data.spouses.size() <= 10
        && validAnniversary(data.anniversary)
        && (data.biography == null || (data.biography is string && data.biography.size() <= 5000))
        && (data.hometown == null || (data.hometown is string && data.hometown.size() <= 100))
        && data.needsVerification is bool
        && (data.sourceReference == null || (data.sourceReference is string && data.sourceReference.size() <= 500));
    }

    function validMembership(familyId, userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['role', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])
        && data.role == 'super_admin'
        && userId == familyDocument(familyId).data.superAdminUid;
    }

    function validGalleryAlbum() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'slug', 'description', 'year', 'coverPhotoId', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'slug', 'description', 'year', 'coverPhotoId', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 70
        && (data.description == null || (data.description is string && data.description.size() <= 400))
        && (data.year == null || (data.year is int && data.year >= 1000 && data.year <= 3000))
        && (data.coverPhotoId == null || (data.coverPhotoId is string && data.coverPhotoId.size() <= 150));
    }

    function validGalleryPhoto() {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'caption', 'cloudinaryPublicId', 'imageUrl', 'width', 'height', 'format', 'bytes', 'albumId', 'albumName', 'year', 'takenAt', 'featured', 'uploadedByUid', 'uploadedByName', 'searchTerms', 'deletionPending', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'caption', 'cloudinaryPublicId', 'imageUrl', 'width', 'height', 'format', 'bytes', 'albumId', 'albumName', 'year', 'takenAt', 'featured', 'uploadedByUid', 'uploadedByName', 'searchTerms', 'deletionPending', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && (data.caption == null || (data.caption is string && data.caption.size() <= 1200))
        && data.cloudinaryPublicId is string && data.cloudinaryPublicId.size() >= 1 && data.cloudinaryPublicId.size() <= 300
        && data.imageUrl is string && data.imageUrl.matches('https://res\\.cloudinary\\.com/.*')
        && data.width is int && data.width >= 1 && data.height is int && data.height >= 1
        && data.format in ['jpg', 'jpeg', 'png', 'webp']
        && data.bytes is int && data.bytes >= 1 && data.bytes <= 10485760
        && data.albumId is string && data.albumId.size() >= 1 && data.albumId.size() <= 150
        && data.albumName is string && data.albumName.size() >= 1 && data.albumName.size() <= 80
        && (data.year == null || (data.year is int && data.year >= 1000 && data.year <= 3000))
        && (data.takenAt == null || (data.takenAt is string && data.takenAt.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        && data.featured is bool
        && data.uploadedByUid is string && data.uploadedByUid.size() >= 1
        && (data.uploadedByName == null || (data.uploadedByName is string && data.uploadedByName.size() <= 150))
        && data.searchTerms is list && data.searchTerms.size() <= 40
        && data.deletionPending is bool;
    }

    match /families/{familyId} {
      allow get: if hasMembership(familyId);
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create: if canEdit(familyId) && validMember(memberId);
        allow update: if canEdit(familyId) && validMember(memberId)
          && request.resource.data.id == resource.data.id;
        allow delete: if isSuperAdmin(familyId);
      }

      match /memberships/{userId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || isSuperAdmin(familyId));
        allow list: if isSuperAdmin(familyId);
        allow create, update: if isSuperAdmin(familyId)
          && validMembership(familyId, userId)
          && (userId != familyDocument(familyId).data.superAdminUid
            || request.resource.data.role == 'super_admin');
        allow delete: if isSuperAdmin(familyId)
          && userId != familyDocument(familyId).data.superAdminUid;
      }

      match /albums/{albumId} {
        allow read: if true;
        allow create, update: if isSuperAdmin(familyId) && validGalleryAlbum();
        allow delete: if isSuperAdmin(familyId);
      }

      match /photos/{photoId} {
        allow read: if true;
        allow create: if isSuperAdmin(familyId) && validGalleryPhoto();
        allow update: if isSuperAdmin(familyId) && validGalleryPhoto()
          && request.resource.data.cloudinaryPublicId == resource.data.cloudinaryPublicId
          && request.resource.data.imageUrl == resource.data.imageUrl;
        allow delete: if isSuperAdmin(familyId);
      }
    }
  }
}
