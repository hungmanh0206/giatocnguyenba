rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function familyDocument(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function membership(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/memberships/$(request.auth.uid));
    }

    function hasMembership(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/memberships/$(request.auth.uid));
    }

    function isSuperAdmin(familyId) {
      return hasMembership(familyId)
        && exists(/databases/$(database)/documents/families/$(familyId))
        && familyDocument(familyId).data.superAdminUid == request.auth.uid
        && membership(familyId).data.role == 'super_admin';
    }

    function canEdit(familyId) {
      return isSuperAdmin(familyId);
    }

    function validAnniversary(value) {
      return value == null || (value is map
        && value.keys().hasOnly(['day', 'month'])
        && value.day is int && value.day >= 1 && value.day <= 30
        && value.month is int && value.month >= 1 && value.month <= 12);
    }

    function validMember(memberId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'name', 'gender', 'isClanMember', 'lineageType', 'generation', 'branch', 'born', 'died', 'parents', 'spouses', 'anniversary', 'biography', 'hometown', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'name', 'gender', 'isClanMember', 'lineageType', 'generation', 'branch', 'born', 'died', 'parents', 'spouses', 'anniversary', 'biography', 'hometown', 'createdAt', 'updatedAt'])
        && data.id == memberId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.gender in ['male', 'female']
        && data.isClanMember is bool
        && data.lineageType in ['direct', 'maternal-terminal']
        && data.generation is int && data.generation >= 1 && data.generation <= 50
        && data.branch is int && data.branch >= 0 && data.branch <= 20
        && data.born is int && data.born >= 1600 && data.born <= 3000
        && (data.died == null || (data.died is int && data.died >= data.born && data.died <= 3000))
        && data.parents is list && data.parents.size() <= 2
        && data.spouses is list && data.spouses.size() <= 10
        && validAnniversary(data.anniversary)
        && (data.biography == null || (data.biography is string && data.biography.size() <= 5000))
        && (data.hometown == null || (data.hometown is string && data.hometown.size() <= 100));
    }

    function validMembership(familyId, userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['role', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])
        && data.role == 'super_admin'
        && userId == familyDocument(familyId).data.superAdminUid;
    }

    match /families/{familyId} {
      allow get: if hasMembership(familyId);
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create: if canEdit(familyId) && validMember(memberId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if canEdit(familyId) && validMember(memberId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSuperAdmin(familyId);
      }

      match /memberships/{userId} {
        allow get: if signedIn()
          && (request.auth.uid == userId || isSuperAdmin(familyId));
        allow list: if isSuperAdmin(familyId);
        allow create, update: if isSuperAdmin(familyId)
          && validMembership(familyId, userId)
          && (userId != familyDocument(familyId).data.superAdminUid
            || request.resource.data.role == 'super_admin');
        allow delete: if isSuperAdmin(familyId)
          && userId != familyDocument(familyId).data.superAdminUid;
      }
    }
  }
}
