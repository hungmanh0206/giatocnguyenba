# Firebase Web app configuration. All NEXT_PUBLIC_ values are browser-visible by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_FAMILY_ID=nguyen-ba

# Used by server-only Firebase administration and `pnpm firebase:grant-admin`; never expose these as NEXT_PUBLIC_ values.
FIREBASE_PROJECT_ID=
FIREBASE_FAMILY_ID=nguyen-ba
FIREBASE_SUPER_ADMIN_UID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary is queried only by the server route. Never expose these as NEXT_PUBLIC_ values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Kho ảnh luôn dùng duy nhất asset folder: Gia tộc nguyễn bá

# Optional: powers the enhanced Tử vi AI response. The key stays server-only.
OPENAI_API_KEY=
OPENAI_FORTUNE_MODEL=gpt-5-mini
