# Firebase Web app configuration. All NEXT_PUBLIC_ values are browser-visible by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_FAMILY_ID=nguyen-ba

# Used by server-only Firebase administration and `pnpm firebase:grant-admin`; never expose these as NEXT_PUBLIC_ values.
FIREBASE_PROJECT_ID=
FIREBASE_FAMILY_ID=nguyen-ba
FIREBASE_SUPER_ADMIN_UID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary is queried only by the server route. Never expose these as NEXT_PUBLIC_ values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Kho ảnh luôn dùng duy nhất asset folder: Gia tộc nguyễn bá

# AI Assistant. Keys are server-only; set the public flag to false to hide the UI.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
# Used automatically if the selected Gemini model is temporarily unavailable.
AI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# OpenAI is used when selected in the UI, or as the automatic backup for Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=true

# Set false to hide the independent Tử vi AI screen. Gemini stays server-only.
NEXT_PUBLIC_ASTROLOGY_ENABLED=true
